#!/usr/bin/env python3
"""Control a Chromecast that go2tv is casting to (optional tvcast backend).

    tvcast-chromecast --check                      exit 0 if pychromecast is installed
    tvcast-chromecast <ip> <port> status           prints "<STATE> <pos-s> <dur-s>"
    tvcast-chromecast <ip> <port> pause|play|stop
    tvcast-chromecast <ip> <port> seek <seconds>

STATE uses the DLNA AVTransport words so tvcast treats both backends alike:
PLAYING, PAUSED_PLAYBACK, TRANSITIONING, STOPPED or NO_MEDIA_PRESENT.

It joins the Default Media Receiver session go2tv started, as a second sender.
It never launches an app: when nothing is casting it reports NO_MEDIA_PRESENT
and refuses commands. Exit codes: 0 ok, 1 device error, 2 usage, 3 pychromecast
missing. The device is untrusted: only private LAN addresses are accepted, and
tvcast runs this under a timeout and a memory limit.
"""

import ipaddress
import os
import sys
import uuid

# Google's Default Media Receiver, and the receiver app go2tv 2.x launches.
MEDIA_RECEIVERS = {"CC1AD845", "C2568A1A"}
MEDIA_NS = "urn:x-cast:com.google.cast.media"
STATES = {
    "PLAYING": "PLAYING",
    "PAUSED": "PAUSED_PLAYBACK",
    "BUFFERING": "TRANSITIONING",
    "IDLE": "STOPPED",
}


def fail(msg, code=1):
    print(f"tvcast-chromecast: {msg}", file=sys.stderr)
    sys.exit(code)


def lan_ip(text):
    try:
        ip = ipaddress.ip_address(text)
    except ValueError:
        return None
    if ip.is_loopback:
        return ip if os.environ.get("TVCAST_ALLOW_LOOPBACK") == "1" else None
    if str(ip) == "169.254.169.254":  # cloud metadata
        return None
    if ip.is_private or ip.is_link_local:
        return ip
    return None


def main(argv):
    try:
        import pychromecast  # noqa: PLC0415 (optional dependency)
    except ImportError:
        fail("python-pychromecast is not installed", 3)
    if argv[1:] == ["--check"]:
        return 0
    if len(argv) < 4:
        fail("usage: tvcast-chromecast <ip> <port> status|pause|play|stop|seek <s>", 2)
    host, port, cmd, *rest = argv[1:]
    ip = lan_ip(host)
    if ip is None:
        fail(f"refusing non-LAN address {host!r}", 2)
    if not port.isdigit() or not 0 < int(port) < 65536:
        fail(f"bad port {port!r}", 2)
    if cmd not in ("status", "pause", "play", "stop", "seek"):
        fail(f"unknown command {cmd!r}", 2)
    if cmd == "seek" and (len(rest) != 1 or not rest[0].isdigit() or len(rest[0]) > 9):
        fail("seek needs whole seconds", 2)

    from pychromecast.models import CastInfo, HostServiceInfo  # noqa: PLC0415

    # A preset cast_type stops pychromecast from also fetching
    # http://<ip>:8008/setup/eureka_info; the cast port is all we talk to.
    info = CastInfo(
        {HostServiceInfo(str(ip), int(port))}, uuid.UUID(int=0), "Chromecast", None,
        str(ip), int(port), "cast", "Google Inc.",
    )
    cast = pychromecast.Chromecast(cast_info=info, tries=1, retry_wait=0.1, timeout=4)
    try:
        cast.wait(timeout=5)
        status = cast.status
        if status is None:
            fail("no answer from the Chromecast")
        # Only join go2tv's session. Touching the media controller while
        # another app runs would make pychromecast launch the media receiver.
        if status.app_id not in MEDIA_RECEIVERS and MEDIA_NS not in (status.namespaces or []):
            if cmd == "status":
                print("NO_MEDIA_PRESENT 0 0")
                return 0
            fail("nothing is casting on this Chromecast")
        mc = cast.media_controller
        mc.block_until_active(timeout=4)
        ms = mc.status
        if cmd == "status":
            state = STATES.get(ms.player_state, "NO_MEDIA_PRESENT")
            if ms.media_session_id is None:
                state = "NO_MEDIA_PRESENT"
            pos = int(ms.adjusted_current_time or ms.current_time or 0)
            dur = int(ms.duration or 0)
            print(f"{state} {max(pos, 0)} {max(dur, 0)}")
            return 0
        if ms.media_session_id is None:
            fail("nothing is casting on this Chromecast")
        if cmd == "seek":
            mc.seek(int(rest[0]), timeout=5)
        else:
            getattr(mc, cmd)(timeout=5)
        return 0
    finally:
        cast.disconnect(timeout=2)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except SystemExit:
        raise
    except Exception as e:  # noqa: BLE001 (any device/protocol error)
        fail(f"{type(e).__name__}: {e}")
