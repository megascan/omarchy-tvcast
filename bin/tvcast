#!/bin/bash

# tvcast: cast local video, audio and image files to a DLNA TV or a Chromecast
# with go2tv, as a play queue. DLNA is controlled over UPnP AVTransport;
# Chromecast (experimental) through bin/tvcast-chromecast, which needs the
# optional python-pychromecast.
#
#   tvcast cast [--pick] [file...]   replace the queue and play (picker if no files)
#   tvcast add [--pick] [file...]    append to the queue (starts it if empty)
#   tvcast next | prev               skip within the queue
#   tvcast play-index <N>            play item N (1-based)
#   tvcast remove <N>                drop item N
#   tvcast move <N> up|down          reorder
#   tvcast clear                     stop and empty the queue
#   tvcast list                      queue as JSON (no network)
#   tvcast play | toggle | pause | resume
#   tvcast seek <+N|-N|secs|hh:mm:ss>
#   tvcast seek-to <secs>            jump to an absolute position (clamped)
#   tvcast stop                      stop playback, keep the queue
#   tvcast volume [N|+N|-N|up|down]  TV volume 0-100 (no argument: print it)
#   tvcast mute [on|off|toggle]      mute the TV (default: toggle)
#   tvcast status [--json]           now playing (+ TV state and position)
#   tvcast devices [--json]          discover TVs and Chromecasts (a few seconds)
#   tvcast pick-device               discover and choose the TV to cast to
#   tvcast active | has-queue [min]  exit 0 while casting / while queued
#
# Playback runs as the transient user unit megascan-tvcast.service ("tvcast _run"),
# which plays the queue item by item: go2tv under script(1) (its CLI needs a
# terminal), and the end of each file is detected by polling the TV (DLNA)
# or the Chromecast's media status, plus go2tv exiting at the end (Chromecast).
# --pick searches the network for TVs instead of reusing the last one.

# jq filters are single-quoted on purpose; $vars in them are jq variables.
# shellcheck disable=SC2016
set -uo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
UNIT=megascan-tvcast.service
LEGACY_UNIT=tvcast.service # 0.5.4 and older
GO2TV=${TVCAST_GO2TV:-$(command -v go2tv || echo "$HOME/.local/bin/go2tv")}
CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/tvcast
STATE_FILE=$CACHE_DIR/state.json
DEVICE_FILE=$CACHE_DIR/device
LOG_FILE=$CACHE_DIR/session.log
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/tvcast
QUEUE_FILE=$STATE_DIR/queue.json
LOCK_FILE=$STATE_DIR/lock
CC_STATUS_FILE=$CACHE_DIR/chromecast-status
AVT=urn:schemas-upnp-org:service:AVTransport:1
RCS=urn:schemas-upnp-org:service:RenderingControl:1
RC_FILE=$CACHE_DIR/rendering
CAST_HELPER=${TVCAST_CAST_HELPER:-${SELF%/*}/tvcast-chromecast}
PYCHROMECAST_HINT="Chromecast pause, seek and progress need python-pychromecast (sudo pacman -S python-pychromecast)."

# Extensions offered by the file picker.
VIDEO_EXT="mp4 m4v mkv webm mov avi wmv flv mpg mpeg ts m2ts 3gp ogv"
AUDIO_EXT="mp3 flac wav m4a aac ogg oga opus wma alac aiff"
IMAGE_EXT="jpg jpeg png gif bmp webp heic"

# What an LG webOS DLNA renderer plays without help. Anything else is
# transcoded by go2tv's ffmpeg path (-tc). Override with TVCAST_TRANSCODE=always|never.
OK_CONTAINERS=" mp4 m4v mkv mov ts m2ts mpg mpeg avi "
OK_VCODECS=" h264 hevc mpeg2video mpeg4 "
OK_ACODECS=" aac ac3 eac3 mp3 mp2 pcm_s16le pcm_s24le "

# Queue, state and go2tv's log name the files being watched: owner-only.
# chmod also tightens dirs created by older versions with the default umask.
umask 077
mkdir -p "$CACHE_DIR" "$STATE_DIR"
chmod 700 "$CACHE_DIR" "$STATE_DIR" 2>/dev/null

# markup_escape <text>: the notification daemon renders markup (links, bold), and
# titles and TV names are untrusted, so &, < and > are always escaped.
markup_escape() {
  local s=$1
  s=${s//&/\&amp;}
  s=${s//</\&lt;}
  s=${s//>/\&gt;}
  printf '%s' "$s"
}

# no_option <text>: omarchy-notification-send reads a headline or body that
# looks like an option ("--image=URL", "-r 5") as one, and titles and TV names
# are untrusted, so a leading dash gets a word joiner (U+2060) in front.
no_option() { if [[ ${1:-} == -* ]]; then printf '\u2060%s' "$1"; else printf '%s' "${1:-}"; fi; }

notify() { # notify <urgency> <headline> [body]; TVCAST_QUIET=1 prints instead
  [[ -n ${TVCAST_QUIET:-} ]] && { printf 'notify: %s: %s\n' "$(no_option "$2")" "$(no_option "${3:-}")" >&2; return; }
  omarchy-notification-send -g "󰄘" -u "$1" "$(no_option "$(markup_escape "$2")")" "$(no_option "$(markup_escape "${3:-}")")" >/dev/null 2>&1 ||
    printf '%s: %s\n' "$2" "${3:-}" >&2
}

# clean_text <max>: drop control characters (escape sequences, tabs, newlines)
# from untrusted text on stdin and cap its length.
# C0 and DEL go byte-wise; C1 controls (U+0080-U+009F, e.g. the 8-bit CSI) too,
# and invisible or bidi-reordering characters (U+200B-U+200F, U+202A-U+202E,
# U+2066-U+2069, U+FEFF) that would disguise a name.
clean_text() {
  local s
  s=$(LC_ALL=C tr -d '\000-\037\177' |
    LC_ALL=C sed 's/\xc2[\x80-\x9f]//g; s/\xe2\x80[\x8b-\x8f\xaa-\xae]//g; s/\xe2\x81[\xa6-\xa9]//g; s/\xef\xbb\xbf//g')
  printf '%s\n' "${s:0:$1}"
}

die() {
  notify critical "Cast to TV" "$1"
  exit 1
}

# A unit is ours only if it is transient and its main command is this plugin's
# "tvcast _run"; anything else with the same name is left alone.
owns_unit() {
  local props
  props=$(systemctl --user show "$1" -p Transient -p ExecStart 2>/dev/null) || return 1
  [[ $props == *Transient=yes* ]] || return 1
  [[ $props == *" $SELF _run "* || $props == *"/megascan.tvcast/bin/tvcast _run "* ]]
}
active_unit() {
  local u
  for u in "$UNIT" "$LEGACY_UNIT"; do
    systemctl --user -q is-active "$u" 2>/dev/null && owns_unit "$u" && { echo "$u"; return 0; }
  done
  return 1
}
is_active() { active_unit >/dev/null; }

# go2tv before 2.5.0 re-fetches the device description and follows whatever
# controlURL/URLBase the device advertises, bypassing our origin checks.
# 2.5.0 added its own endpoint pinning (validateServiceEndpoints).
GO2TV_MIN=2.5.0
require_go2tv() {
  [[ -x $GO2TV ]] || die "go2tv is not installed (expected $GO2TV)."
  local v
  v=$("$GO2TV" -version 2>/dev/null </dev/null | sed -nE 's/.*[Vv]ersion:? *v?([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' | head -n1)
  [[ -n $v ]] || die "Could not read the go2tv version; tvcast needs go2tv $GO2TV_MIN or newer."
  [[ $(printf '%s\n%s\n' "$GO2TV_MIN" "$v" | sort -V | head -n1) == "$GO2TV_MIN" ]] ||
    die "go2tv $v is too old; tvcast needs $GO2TV_MIN or newer (older versions don't pin TV control URLs)."
}

# ---------- state ----------

write_state() { # write_state <json>; written in place so the bar's file watch fires
  printf '%s\n' "$1" >"$STATE_FILE"
}

state_get() { jq -r --arg k "$1" '.[$k] // empty' "$STATE_FILE" 2>/dev/null; }

# uint <value>: prints the value if it is a plain non-negative integer, else 0.
# Anything read from the queue, the state file or a device goes through this
# before bash arithmetic: $(( )), (( )), [[ -gt ]] and array subscripts all
# evaluate "a[$(cmd)]" and would run cmd.
uint() {
  if [[ ${1:-} =~ ^[0-9]{1,9}$ ]]; then printf '%d\n' "$((10#$1))"; else echo 0; fi
}

# ---------- UPnP ----------

xpath_str() { # xpath_str <expr>, XML on stdin
  xmllint --nonet --xpath "string($1)" - 2>/dev/null # --nonet: never fetch DTDs or entities
}

# Everything a device tells us (SSDP LOCATION, URLBase, controlURL) is
# untrusted, so every request goes only to plain http(s) on a private LAN
# address, never follows redirects, and control requests stay on the exact
# origin (scheme, host, port) that served the device description.
# Bodies are capped at MAX_BODY: --max-filesize stops declared sizes, and
# fetch's head -c stops chunked replies, which carry no size up front.
MAX_BODY=1048576
# -q: ignore ~/.curlrc; --noproxy: device requests never go through a proxy.
# -g: brackets and braces in a device URL are literal, never a curl URL range.
CURL=(curl -q -g --noproxy '*' --proto '=http,https' --max-redirs 0 --max-filesize "$MAX_BODY")

fetch() { "${CURL[@]}" "$@" | head -c "$MAX_BODY"; } # fetch <curl args...>

# url_origin <url>: prints scheme://host:port (lowercase), fails if malformed.
# Hostnames are rejected on purpose (DNS rebinding); TVs announce IP addresses.
# Only canonical dotted decimal is accepted: curl reads "010.0.0.1" as octal
# (8.0.0.1), so a leading zero would make our check and curl's target differ.
# Ports must be canonical too, or ":08009" would split url_type and go2tv.
OCTET='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
url_origin() {
  local u=${1,,} scheme host port
  [[ $u =~ ^(https?)://($OCTET\.$OCTET\.$OCTET\.$OCTET|\[[0-9a-f:]+\])(:([1-9][0-9]{0,4}))?(/[[:graph:]]*)?$ ]] || return 1
  scheme=${BASH_REMATCH[1]} host=${BASH_REMATCH[2]} port=${BASH_REMATCH[8]}
  [[ -n $port ]] || { [[ $scheme == https ]] && port=443 || port=80; }
  ((port <= 65535)) || return 1
  printf '%s://%s:%s\n' "$scheme" "$host" "$port"
}

# ipv6_full <addr>: the address as 8 four-digit hex groups, so differently
# compressed spellings compare equal. Fails on anything malformed.
ipv6_full() {
  local a=${1,,} head tail out="" g n i
  local -a hg=() tg=()
  [[ $a =~ ^[0-9a-f:]+$ && $a != *:::* ]] || return 1
  if [[ $a == *::* ]]; then
    head=${a%%::*} tail=${a#*::}
    [[ $tail != *::* ]] || return 1
    [[ -n $head ]] && IFS=: read -ra hg <<<"$head"
    [[ -n $tail ]] && IFS=: read -ra tg <<<"$tail"
    n=$((8 - ${#hg[@]} - ${#tg[@]}))
    ((n >= 1)) || return 1
    for ((i = 0; i < n; i++)); do hg+=(0); done
    hg+=("${tg[@]}")
  else
    IFS=: read -ra hg <<<"$a"
  fi
  ((${#hg[@]} == 8)) || return 1
  for g in "${hg[@]}"; do
    [[ $g =~ ^[0-9a-f]{1,4}$ ]] || return 1
    out+=$(printf '%04x' "$((16#$g))"):
  done
  printf '%s\n' "${out%:}"
}

# own_address <ip>: true if the IP belongs to this machine (any interface,
# docker/libvirt bridges included). A device that announces our own LAN IP
# would otherwise aim our requests at local services listening on 0.0.0.0.
LOCAL_ADDRS=""
own_address() {
  local ip=$1 a
  [[ -n $LOCAL_ADDRS ]] || LOCAL_ADDRS=$(ip -o addr show 2>/dev/null | awk '{print $4}' | sed 's#/.*##')
  [[ -n $LOCAL_ADDRS ]] || return 1
  if [[ $ip == *:* ]]; then
    ip=$(ipv6_full "$ip") || return 0
    while read -r a; do
      [[ $a == *:* ]] || continue
      [[ $(ipv6_full "${a%%%*}") == "$ip" ]] && return 0
    done <<<"$LOCAL_ADDRS"
    return 1
  fi
  grep -qxF -- "$ip" <<<"$LOCAL_ADDRS"
}

# lan_url <url>: succeeds only for a private/link-local LAN address that is
# not one of this machine's own addresses.
# TVCAST_ALLOW_LOOPBACK=1 also allows 127.0.0.0/8 (for testing with a fake TV).
lan_url() {
  local origin host a b c d
  origin=$(url_origin "$1") || return 1
  host=${origin#*://}
  host=${host%:*}
  if [[ $host =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
    a=$((10#${BASH_REMATCH[1]})) b=$((10#${BASH_REMATCH[2]})) c=$((10#${BASH_REMATCH[3]})) d=$((10#${BASH_REMATCH[4]}))
    ((a <= 255 && b <= 255 && c <= 255 && d <= 255)) || return 1
    ((a == 127)) && { [[ ${TVCAST_ALLOW_LOOPBACK:-} == 1 ]]; return; }
    ((a == 10 || (a == 172 && b >= 16 && b <= 31) || (a == 192 && b == 168) ||
      (a == 169 && b == 254 && !(c == 169 && d == 254)))) || return 1 # not cloud metadata
    ! own_address "$host"
    return
  fi
  [[ $host =~ ^\[(fe[89ab][0-9a-f]|f[cd][0-9a-f]{2}): ]] || return 1 # IPv6 link-local / ULA
  host=${host#\[}
  ! own_address "${host%\]}"
}

# service_url <device-description-url> <service> <controlURL|SCPDURL> [xml]:
# absolute URL of one of a service's endpoints, refused unless it is on the
# same origin as the description URL. Pass the description to skip a fetch.
service_url() {
  local desc_url=$1 svc=$2 elem=$3 xml=${4:-} ctl base origin url
  [[ $svc =~ ^[A-Za-z]+$ && $elem =~ ^(controlURL|SCPDURL)$ ]] || return 1
  lan_url "$desc_url" || return 1
  origin=$(url_origin "$desc_url") || return 1
  [[ -n $xml ]] || xml=$(fetch -fsS -m 4 "$desc_url") || return 1
  ctl=$(xpath_str "//*[local-name()='service'][*[local-name()='serviceType' and contains(., '$svc')]]/*[local-name()='$elem']" <<<"$xml")
  [[ -n $ctl ]] || return 1
  if [[ ${ctl,,} =~ ^[a-z][a-z0-9+.-]*: ]]; then
    url=$ctl
  else
    base=$(xpath_str "//*[local-name()='URLBase']" <<<"$xml")
    # A URLBase pointing anywhere but the description's origin is ignored.
    [[ -n $base && $(url_origin "$base") == "$origin" ]] || base=$(sed -E 's#^(https?://[^/]+).*#\1#' <<<"$desc_url")
    base=${base%/}
    [[ $ctl == /* ]] || ctl=/$ctl
    url=$base$ctl
  fi
  [[ $(url_origin "$url") == "$origin" ]] || {
    echo "tvcast: refusing control URL outside the TV's own address: $url" >&2
    return 1
  }
  printf '%s\n' "$url"
}

control_url() { service_url "$1" AVTransport controlURL; } # control_url <desc-url>

device_name() { # device_name <desc-url>
  lan_url "$1" || return 1
  fetch -fsS -m 3 "$1" 2>/dev/null | xpath_str "//*[local-name()='device']/*[local-name()='friendlyName']"
}

# url_type <url>: chromecast or dlna, by the rule go2tv itself uses to route
# -t (port 8009 is a Chromecast), so we never disagree with go2tv.
url_type() {
  local o
  o=$(url_origin "$1") || { echo dlna; return; }
  if [[ ${o##*:} == 8009 ]]; then echo chromecast; else echo dlna; fi
}

# url_hostport <url>: prints "<ip> <port>" (IPv6 without brackets).
url_hostport() {
  local o host
  o=$(url_origin "$1") || return 1
  host=${o#*://}
  host=${host%:*}
  host=${host#\[}
  printf '%s %s\n' "${host%\]}" "${o##*:}"
}

# Receiver identity. An address alone doesn't name a TV: DHCP can hand it to
# another device that answers at the same endpoint. So a chosen device is
# saved with the ID it announces (DLNA: the root device's UDN; Chromecast: the
# mDNS TXT id), and it is reused only while the device at that address still
# reports the same ID. The ID is self-announced: this catches a reassigned
# address, not a device that copies another's ID.
DEV_ID_RE='^[A-Za-z0-9:._-]{1,128}$'

dlna_udn() { # dlna_udn: the root device's UDN from the description XML on stdin
  local id
  id=$(xpath_str "/*[local-name()='root']/*[local-name()='device']/*[local-name()='UDN']" | clean_text 200)
  id=${id//[[:space:]]/}
  [[ $id =~ $DEV_ID_RE ]] && printf '%s\n' "$id"
}

# device_id <url>: prints the ID the device at that address announces now.
# Exit 1: no answer; exit 2: it answered without a usable (or a unique) ID.
device_id() {
  local url=$1 xml ids
  lan_url "$url" || return 1
  if [[ $(url_type "$url") == chromecast ]]; then
    ids=$(python3 -I "$DISCOVER_HELPER" mdns 2 2>/dev/null |
      awk -F'\t' -v u="$url" '$2 == u && $4 != "" {print $4}' | sort -u)
    [[ -n $ids ]] || return 1
    [[ $ids != *$'\n'* && $ids =~ $DEV_ID_RE ]] || return 2
    printf '%s\n' "$ids"
    return
  fi
  xml=$(fetch -fsS -m 3 "$url" 2>/dev/null) || return 1
  [[ -n $xml ]] || return 1
  dlna_udn <<<"$xml" || return 2
}

# verify_device <url> <saved-id>: true only if the device at the address
# reports the saved ID. On failure DEV_ERR is "noid", "down" or "changed".
DEV_ERR=""
verify_device() {
  local url=$1 want=$2 got rc tries=${3:-1}
  DEV_ERR=noid
  [[ $want =~ $DEV_ID_RE ]] || return 1
  while :; do
    rc=0
    got=$(device_id "$url") || rc=$?
    ((rc == 1 && --tries > 0)) || break
    sleep 1
  done
  DEV_ERR=down
  ((rc == 1)) && return 1
  DEV_ERR=changed
  ((rc == 0)) && [[ $got == "$want" ]] || return 1
  DEV_ERR=""
}

soap() { soap_call "$(state_get control)" "$AVT" "$@"; } # soap <action> [inner-xml]

# soap_call <control-url> <service-urn> <action> [inner-xml]: prints the body.
soap_call() {
  local ctl=$1 urn=$2 action=$3 args=${4:-} url
  [[ -n $ctl ]] || { echo "tvcast: nothing is casting" >&2; return 1; }
  # Re-check: state written by an older version may hold an unchecked URL.
  url=$(q_get '.device.url // empty' 2>/dev/null)
  if ! lan_url "$ctl" || { [[ -n $url ]] && [[ $(url_origin "$ctl") != "$(url_origin "$url")" ]]; }; then
    echo "tvcast: refusing control URL outside the TV's own address: $ctl" >&2
    return 1
  fi
  fetch -fsS -m 5 -X POST "$ctl" \
    -H 'Content-Type: text/xml; charset="utf-8"' \
    -H "SOAPACTION: \"$urn#$action\"" \
    --data-binary "<?xml version=\"1.0\" encoding=\"utf-8\"?>
<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" s:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\"><s:Body><u:$action xmlns:u=\"$urn\"><InstanceID>0</InstanceID>$args</u:$action></s:Body></s:Envelope>"
}

hms_to_s() { # 1:02:03(.000) -> seconds
  local t=${1%%.*} h m s
  [[ $t =~ ^([0-9]{1,6}):([0-9]{1,2}):([0-9]{1,2})$ ]] || { echo 0; return; }
  h=${BASH_REMATCH[1]} m=${BASH_REMATCH[2]} s=${BASH_REMATCH[3]}
  echo $((10#$h * 3600 + 10#$m * 60 + 10#$s))
}

s_to_hms() { printf '%d:%02d:%02d\n' $(($1 / 3600)) $(($1 % 3600 / 60)) $(($1 % 60)); }

# ---------- Chromecast (experimental) ----------
# The device is as untrusted as a DLNA one: LAN IPs only (checked here and in
# the helper), a timeout, a memory cap (Cast frames declare their own length),
# and at most 4 KiB of output.

cast_ready() { [[ -x $CAST_HELPER ]] && "$CAST_HELPER" --check >/dev/null 2>&1; }

cast_helper() { # cast_helper <device-url> status|pause|play|stop|seek <s>|volume <0-100>|mute on|off; exit 3: no pychromecast
  local url=$1 host port
  shift
  lan_url "$url" || return 1
  read -r host port < <(url_hostport "$url") || return 1
  [[ -x $CAST_HELPER ]] || return 3
  (
    ulimit -v 1048576 2>/dev/null
    exec timeout 15 "$CAST_HELPER" "$host" "$port" "$@"
  ) 2>/dev/null | head -c 4096
}

# cc_line: the helper's raw status line "<STATE> <pos> <dur> <vol> <muted>"
# for the active Chromecast. The runner polls the device and caches the
# answer, so the bar's status calls reuse it.
cc_line() {
  local ctl line="" age
  if [[ -z ${TVCAST_IN_RUNNER:-} && -s $CC_STATUS_FILE ]]; then
    age=$(($(date +%s) - $(stat -c %Y "$CC_STATUS_FILE" 2>/dev/null || echo 0)))
    ((age <= 5)) && line=$(head -c 200 "$CC_STATUS_FILE")
  fi
  if [[ -z $line ]]; then
    ctl=$(state_get control)
    [[ -n $ctl ]] || return 1
    line=$(cast_helper "$ctl" status) || return 1
    [[ -n ${TVCAST_IN_RUNNER:-} ]] && printf '%s\n' "$line" >"$CC_STATUS_FILE"
  fi
  printf '%s\n' "$line"
}

cc_status() { # "<STATE> <pos> <dur>"
  local st pos dur _
  read -r st pos dur _ < <(cc_line) || return 1
  [[ $st =~ ^[A-Z_]{1,32}$ ]] || return 1
  printf '%s %s %s\n' "$st" "$(uint "$pos")" "$(uint "$dur")"
}

# active_type: backend of what is casting now (state written by the runner).
active_type() { if [[ $(state_get type) == chromecast ]]; then echo chromecast; else echo dlna; fi; }

transport_state() {
  if [[ $(active_type) == chromecast ]]; then
    local st _
    read -r st _ < <(cc_status) || return 1
    printf '%s\n' "$st"
    return
  fi
  local st
  st=$(soap GetTransportInfo | xpath_str "//*[local-name()='CurrentTransportState']")
  [[ $st =~ ^[A-Z_]{1,40}$ ]] || st=UNKNOWN
  printf '%s\n' "$st"
}

position_info() { # prints "<pos-seconds> <duration-seconds>"
  local xml
  if [[ $(active_type) == chromecast ]]; then
    local _ pos dur
    read -r _ pos dur < <(cc_status) || return 1
    echo "$pos $dur"
    return
  fi
  xml=$(soap GetPositionInfo) || return 1
  echo "$(hms_to_s "$(xpath_str "//*[local-name()='RelTime']" <<<"$xml")") $(hms_to_s "$(xpath_str "//*[local-name()='TrackDuration']" <<<"$xml")")"
}

# dev_status: "<STATE> <pos> <dur>" in one go (one device query on Chromecast).
dev_status() {
  local st pos=0 dur=0
  if [[ $(active_type) == chromecast ]]; then cc_status; return; fi
  st=$(transport_state 2>/dev/null)
  read -r pos dur < <(position_info 2>/dev/null) || true
  [[ $st =~ ^[A-Z_]{1,40}$ ]] || st=UNKNOWN
  printf '%s %s %s\n' "$st" "$(uint "$pos")" "$(uint "$dur")"
}

# dev_control pause|play|stop|seek <secs>: send a transport command to the
# active device, whatever its type.
dev_control() {
  if [[ $(active_type) == chromecast ]]; then
    local ctl rc=0
    ctl=$(state_get control)
    [[ -n $ctl ]] || { echo "tvcast: nothing is casting" >&2; return 1; }
    cast_helper "$ctl" "$@" >/dev/null || rc=$?
    ((rc == 3)) && notify normal "Cast to TV" "$PYCHROMECAST_HINT"
    return "$rc"
  fi
  case $1 in
    pause) soap Pause >/dev/null ;;
    play) soap Play '<Speed>1</Speed>' >/dev/null ;;
    stop) soap Stop >/dev/null ;;
    seek) dlna_seek "$2" ;;
    *) return 2 ;;
  esac
}

# dlna_wait_state <regex> <tries>: poll the transport state until it matches,
# up to <tries> more times, 0.5 s apart. Prints the last state; fails on timeout.
dlna_wait_state() {
  local want=$1 n=$2 st=""
  while :; do
    st=$(transport_state 2>/dev/null)
    [[ $st =~ $want ]] && { printf '%s\n' "$st"; return 0; }
    ((n-- > 0)) || break
    sleep 0.5
  done
  printf '%s\n' "${st:-UNKNOWN}"
  return 1
}

# dlna_seek <secs>: LG webOS hangs for good (LG_TRANSITIONING, only Stop
# allowed, later seeks fail with 710) when it gets a Seek while paused, and
# refuses one while it is still loading. So: seek only from PLAYING, wait out
# a short TRANSITIONING, and seek a paused TV by playing, seeking, pausing.
# Seeks are serialised so scroll bursts don't interleave that dance.
# On failure SEEK_ERR holds a message for the user.
SEEK_ERR=""
dlna_seek() {
  local target st repause=""
  target=$(s_to_hms "$(uint "$1")")
  exec 8>"$CACHE_DIR/seek.lock"
  flock -w 20 8 || { SEEK_ERR="Another seek is still running."; return 1; }
  st=$(dlna_wait_state '^(PLAYING|PAUSED_PLAYBACK|STOPPED|NO_MEDIA_PRESENT)$' 20) || true
  case $st in
    PLAYING) ;;
    PAUSED_PLAYBACK)
      soap Play '<Speed>1</Speed>' >/dev/null || { SEEK_ERR="The TV didn't resume, so it can't seek."; return 1; }
      repause=1
      dlna_wait_state '^PLAYING$' 20 >/dev/null || { SEEK_ERR="The TV is still loading this file. Try again in a moment."; return 1; }
      ;;
    LG_TRANSITIONING) SEEK_ERR="The TV is stuck loading this file. Press Stop, then Play."; return 1 ;;
    *TRANSITIONING) SEEK_ERR="The TV is still loading this file. Try again in a moment."; return 1 ;;
    *) SEEK_ERR="The TV isn't playing anything it can seek."; return 1 ;;
  esac
  if ! soap Seek "<Unit>REL_TIME</Unit><Target>$target</Target>" >/dev/null; then
    if [[ $(transport_state 2>/dev/null) == *TRANSITIONING ]]; then
      SEEK_ERR="The TV is stuck loading this file. Press Stop, then Play."
    else
      SEEK_ERR="This TV can't seek in this file."
    fi
    return 1
  fi
  if [[ -n $repause ]]; then
    sleep 1
    soap Pause >/dev/null || true
  fi
}

# ---------- volume ----------
# DLNA volume is RenderingControl (Channel Master) on the same device. Its
# controlURL and the Volume range from its SCPD are resolved with the same
# origin pinning as AVTransport and cached in RC_FILE per description URL
# ("none" is retried after a minute). tvcast always speaks 0-100 and scales
# to the TV's own maximum.

# rc_info: prints "<control-url> <max>" for the active DLNA device.
rc_info() {
  local desc ctl="" scpd max=100 xml cache now
  desc=$(q_get '.device.url // empty')
  [[ -n $desc ]] && lan_url "$desc" || return 1
  now=$(date +%s)
  if [[ -s $RC_FILE ]]; then
    cache=$(jq -c --arg d "$desc" 'select(.device == $d)' "$RC_FILE" 2>/dev/null)
    if [[ -n $cache ]]; then
      ctl=$(jq -r '.control // empty' <<<"$cache")
      max=$(uint "$(jq -r '.max // 0' <<<"$cache")")
      if [[ -n $ctl ]]; then
        [[ $(url_origin "$ctl") == "$(url_origin "$desc")" ]] && lan_url "$ctl" && ((max > 0)) || return 1
        printf '%s\t%s\n' "$ctl" "$max"
        return 0
      fi
      [[ $(jq -r --argjson now "$now" '((.checked // 0) | tonumber? // 0) + 60 > $now' <<<"$cache") == true ]] && return 1
    fi
  fi
  xml=$(fetch -fsS -m 4 "$desc" 2>/dev/null) || xml=""
  if [[ -n $xml ]] && ctl=$(service_url "$desc" RenderingControl controlURL "$xml" 2>/dev/null); then
    max=100
    if scpd=$(service_url "$desc" RenderingControl SCPDURL "$xml" 2>/dev/null); then
      max=$(uint "$(fetch -fsS -m 4 "$scpd" 2>/dev/null |
        xpath_str "//*[local-name()='stateVariable'][*[local-name()='name']='Volume']/*[local-name()='allowedValueRange']/*[local-name()='maximum']")")
      ((max > 0 && max <= 65535)) || max=100
    fi
  else
    ctl=""
  fi
  jq -cn --arg d "$desc" --arg c "$ctl" --argjson m "$max" --argjson t "$now" \
    '{device: $d, control: $c, max: $m, checked: $t}' >"$RC_FILE"
  [[ -n $ctl ]] || return 1
  printf '%s\t%s\n' "$ctl" "$max"
}

# rc_get: sets RC_CTL and RC_MAX for the active DLNA device. The fields are
# split on the tab rc_info writes, and the maximum always goes through uint.
RC_CTL="" RC_MAX=0
rc_get() {
  local line
  RC_CTL="" RC_MAX=0
  line=$(rc_info) || return 1
  [[ $line == *$'\t'* ]] || return 1
  RC_CTL=${line%%$'\t'*}
  RC_MAX=$(uint "${line##*$'\t'}")
  [[ -n $RC_CTL ]] && ((RC_MAX > 0))
}

rc_soap() { # rc_soap <control-url> <action> [inner-xml]
  soap_call "$1" "$RCS" "$2" "<Channel>Master</Channel>${3:-}"
}

# dev_volume: prints "<0-100> <0|1 muted>"; fails if the device has no volume control.
dev_volume() {
  local vol muted ctl max raw m
  if [[ $(active_type) == chromecast ]]; then
    read -r _ _ _ vol muted < <(cc_line) || return 1
    [[ $vol =~ ^[0-9]{1,3}$ ]] || return 1
    vol=$(uint "$vol")
    ((vol > 100)) && vol=100
    [[ $muted == 1 ]] || muted=0
    echo "$vol $muted"
    return
  fi
  rc_get || return 1
  ctl=$RC_CTL max=$RC_MAX
  raw=$(rc_soap "$ctl" GetVolume | xpath_str "//*[local-name()='CurrentVolume']") || return 1
  [[ $raw =~ ^[0-9]{1,5}$ ]] || return 1
  raw=$(uint "$raw")
  ((raw > max)) && raw=$max
  m=$(rc_soap "$ctl" GetMute 2>/dev/null | xpath_str "//*[local-name()='CurrentMute']")
  [[ ${m,,} == 1 || ${m,,} == true ]] && muted=1 || muted=0
  echo "$(((raw * 100 + max / 2) / max)) $muted"
}

# dev_set_volume <0-100> [<current 0-100> <direction -1|0|1>]: on a TV with
# fewer than 100 steps a small relative change still moves at least one step.
dev_set_volume() {
  local pct cur dir ctl max raw
  pct=$(uint "$1") cur=$(uint "${2:-0}") dir=${3:-0}
  ((pct > 100)) && pct=100
  if [[ $(active_type) == chromecast ]]; then
    dev_control volume "$pct"
    return
  fi
  rc_get || return 1
  ctl=$RC_CTL max=$RC_MAX
  raw=$(((pct * max + 50) / 100))
  if [[ $dir == 1 || $dir == -1 ]] && ((raw == (cur * max + 50) / 100)); then
    raw=$((raw + dir))
    ((raw < 0)) && raw=0
    ((raw > max)) && raw=$max
  fi
  rc_soap "$ctl" SetVolume "<DesiredVolume>$raw</DesiredVolume>" >/dev/null
}

dev_set_mute() { # dev_set_mute 0|1
  local ctl _ on=0
  [[ $1 == 1 ]] && on=1
  if [[ $(active_type) == chromecast ]]; then
    if ((on)); then dev_control mute on; else dev_control mute off; fi
    return
  fi
  rc_get || return 1
  ctl=$RC_CTL
  rc_soap "$ctl" SetMute "<DesiredMute>$on</DesiredMute>" >/dev/null
}

# ---------- discovery ----------

# discover: prints "name<TAB>url<TAB>type<TAB>id" per device (dlna|chromecast;
# id is empty when the device announced none).
# Discovery is tvcast's own, not `go2tv -l`: go2tv fetches every SSDP
# LOCATION it hears before returning a list, and accepts any host, so a LAN
# responder could make it send requests anywhere (reported by a marketplace
# reviewer on 0.3.4; upstream: https://github.com/alexballas/go2tv/issues/188).
# bin/tvcast-discover only listens: SSDP replies (no fetch)
# and mDNS via avahi (no fetch). Every address is checked with lan_url, and a
# LOCATION must be on the host that sent the reply, BEFORE anything is fetched.
# The surviving descriptions are then fetched with the capped CURL, a few at
# a time. TVCAST_SCAN_SECONDS sets how long to listen (default 4).
DISCOVER_HELPER=${SELF%/*}/tvcast-discover
MAX_DEVICES=32
discover() {
  local secs=${TVCAST_SCAN_SECONDS:-4} dir src loc n=0 i=0 f name url
  [[ $secs =~ ^[0-9]{1,2}$ ]] || secs=4
  dir=$(mktemp -d "$CACHE_DIR/scan.XXXXXX")
  python3 -I "$DISCOVER_HELPER" mdns "$secs" >"$dir/mdns" 2>/dev/null &
  python3 -I "$DISCOVER_HELPER" ssdp "$secs" 2>/dev/null | sort -u |
    while IFS=$'\t' read -r src loc; do
      ((n++ < MAX_DEVICES * 2)) || break
      lan_url "$loc" || continue
      [[ $(url_type "$loc") == dlna ]] || continue
      [[ $(url_host "$loc") == "$src" ]] || continue # LOCATION must be the replying host
      printf '%s\n' "$loc"
    done | sort -u | head -n "$MAX_DEVICES" >"$dir/locations"
  while read -r loc; do
    # At most four description fetches at once.
    while (($(jobs -rp | wc -l) >= 4)); do wait -n; done
    i=$((i + 1))
    (
      xml=$(fetch -fsS -m 3 "$loc" 2>/dev/null) || exit 0
      [[ -n $(xpath_str "//*[local-name()='service']/*[local-name()='serviceType'][contains(., 'AVTransport')]" <<<"$xml") ]] || exit 0
      # Clean before the name enters the tab-separated list: a raw tab or
      # newline in friendlyName could otherwise forge a second entry.
      name=$(xpath_str "//*[local-name()='device']/*[local-name()='friendlyName']" <<<"$xml" | clean_text 120)
      [[ -n $name ]] || name=TV
      printf '%s\t%s\tdlna\t%s\n' "$name" "$loc" "$(dlna_udn <<<"$xml")"
    ) >"$dir/dlna.$i" &
  done <"$dir/locations"
  wait
  for f in "$dir"/dlna.* "$dir/mdns"; do
    [[ -s $f ]] || continue
    head -n "$MAX_DEVICES" "$f"
  done | while IFS=$'\t' read -r name url tag id; do
    lan_url "$url" || continue
    [[ $id =~ $DEV_ID_RE ]] || id=""
    # A DLNA entry must be one of the vetted SSDP locations (the replying host).
    [[ $tag != dlna ]] || grep -qxF -- "$url" "$dir/locations" || continue
    # go2tv routes -t by port alone, so skip anything it would misroute
    # (Chromecast groups on other ports, a DLNA device on 8009).
    [[ $tag == "$(url_type "$url")" ]] || continue
    name=$(clean_text 120 <<<"$name")
    [[ -n $name ]] || name=TV
    printf '%s\t%s\t%s\t%s\n' "$name" "$url" "$tag" "$id"
  done | sort -u -t $'\t' -k2,2
  rm -rf "$dir"
}

cmd_devices() {
  local list
  list=$(discover)
  if [[ ${1:-} == --json ]]; then
    jq -Rn '[inputs | split("\t") | select(length == 4) | {name: .[0], url: .[1], type: .[2], id: .[3]}]' <<<"$list"
  else
    [[ -n $list ]] && printf '%s\n' "$list"
  fi
  [[ -n $list ]]
}

# url_host <url>: the IP address part of a URL, for showing in menus.
url_host() {
  local o
  o=$(url_origin "$1") || return 1
  o=${o#*://}
  printf '%s\n' "${o%:*}"
}

# choose_device [--pick]: prints "name<TAB>url<TAB>id" (the type follows from the URL).
# Reuses the saved TV only while the device at its address reports the saved
# ID, unless --pick. A newly discovered device is never trusted on its own:
# without --pick, discovery only auto-selects a device at the exact description
# URL we already know that also reports the saved ID; anything else (a single
# new device, or a different device at the old address) goes through the menu,
# which shows each device's IP address. A TV saved without an ID (tvcast 0.5.5
# and older) is offered in the menu once, preselected.
choose_device() {
  local pick=${1:-} sname="" surl="" sid="" known="" kid="" name url id list choice label
  [[ -s $DEVICE_FILE ]] && IFS=$'\t' read -r sname surl sid <"$DEVICE_FILE"
  known=$surl kid=$sid
  [[ -n $known ]] || { known=$(q_get '.device.url // empty'); kid=$(q_get '.device.id // empty'); }
  [[ $kid =~ $DEV_ID_RE ]] || kid=""
  if [[ -z $pick && -n $sname && -n $surl ]] && verify_device "$surl" "$sid"; then
    printf '%s\t%s\t%s\n' "$sname" "$surl" "$sid"
    return
  fi

  notify low "Cast to TV" "Looking for TVs on the network…"
  list=$(discover)
  [[ -n $list ]] || return 1

  choice=""
  if [[ -z $pick && -n $known && -n $kid ]]; then
    while IFS=$'\t' read -r name url _ id; do
      [[ $url == "$known" && $id == "$kid" ]] && { choice=$name$'\t'$url$'\t'$id; break; }
    done <<<"$list"
  fi

  if [[ -z $choice ]]; then
    local options=() selected=() picked
    local type
    while IFS=$'\t' read -r name url type id; do
      if [[ $type == chromecast ]]; then type=Chromecast; else type=DLNA; fi
      label="$name  ($(url_host "$url"), $type)"
      options+=("󰔂"$'\t'"$label"$'\t'"$url")
      [[ $url == "$known" && ( -z $kid || $id == "$kid" ) ]] && selected=(--selected "$label"$'\t'"$url")
    done <<<"$list"
    picked=$(omarchy-menu-select "Cast to" "${options[@]}" -- "${selected[@]}") || return 2
    [[ -n $picked ]] || return 2
    # The menu returns "label<TAB>url"; map the URL back to the device's name.
    url=${picked##*$'\t'}
    while IFS=$'\t' read -r name label _ id; do
      [[ $label == "$url" ]] && { choice=$name$'\t'$label$'\t'$id; break; }
    done <<<"$list"
    [[ -n $choice ]] || return 2
  fi
  printf '%s\n' "$choice" >"$DEVICE_FILE"
  printf '%s\n' "$choice"
}

# ---------- media inspection ----------

ext_of() { local b=${1##*/} e=""; [[ $b == *.* ]] && e=${b##*.}; echo "${e,,}"; }

# Only local video, audio and image files are cast, by content type. go2tv
# reads a -v path ending in .torrent as a BitTorrent session whatever its
# content, and playlists or SVGs make the TV or ffmpeg fetch other URLs, so
# those are refused too. Checked when files are queued and again on the open
# file right before go2tv gets it.
DENY_MIME=" audio/x-mpegurl audio/mpegurl audio/x-scpls audio/scpls image/svg+xml video/x-ms-asx audio/x-ms-wax video/x-ms-wvx "

# mime_of <path>: content type. file(1) reads stdin because its sandbox can't
# open /proc/<pid>/fd links. Only call it on a path known to be a regular file.
mime_of() { file -b --mime-type - <"$1" 2>/dev/null; }

media_ok() { # media_ok <name> <mime>
  local mime=${2,,}
  [[ $(ext_of "$1") != torrent && $mime =~ ^(video|audio|image)/ && $DENY_MIME != *" $mime "* ]]
}

media_kind() { # media_kind <name> <mime>: video|audio|image
  local e
  e=$(ext_of "$1")
  if [[ " $IMAGE_EXT " == *" $e "* ]]; then echo image
  elif [[ " $AUDIO_EXT " == *" $e "* ]]; then echo audio
  else
    case ${2,,} in
      image/*) echo image ;;
      audio/*) echo audio ;;
      *) echo video ;;
    esac
  fi
}

# A queued file is identified by filesystem ID, inode and birth time
# (stat -f %i, not st_dev: btrfs device numbers can change across reboots).
FILE_ID_RE='^[0-9a-f]{1,16}:[0-9]{1,20}:[0-9]{1,20}$'
file_id() { # file_id <path>
  local fs ino
  fs=$(stat -f -L -c %i -- "$1" 2>/dev/null) || return 1
  ino=$(stat -L -c %i:%W -- "$1" 2>/dev/null) || return 1
  [[ $fs:$ino =~ $FILE_ID_RE ]] && printf '%s\n' "$fs:$ino"
}

# open_regular <path>: opens the file read-only on OPEN_FD, only if it is a
# regular file (a FIFO would block the open).
OPEN_FD=""
open_regular() {
  OPEN_FD=""
  [[ -f $1 ]] || return 1
  { exec {OPEN_FD}<"$1"; } 2>/dev/null || { OPEN_FD=""; return 1; }
  [[ -f /proc/$BASHPID/fd/$OPEN_FD ]] && return 0
  exec {OPEN_FD}<&-
  OPEN_FD=""
  return 1
}

# needs_transcode <video>: exit 0 when the TV likely can't play the video as is.
needs_transcode() {
  local f=$1 e streams vcodec acodecs a
  case ${TVCAST_TRANSCODE:-auto} in
    always) return 0 ;;
    never) return 1 ;;
  esac
  e=$(ext_of "$f")
  [[ $OK_CONTAINERS == *" $e "* ]] || return 0
  streams=$(ffprobe -v error -protocol_whitelist file -show_entries stream=codec_type,codec_name -of csv=p=0 -- "$f" 2>/dev/null) || return 0
  vcodec=$(awk -F, '$2 == "video" {print $1; exit}' <<<"$streams")
  [[ -n $vcodec && $OK_VCODECS == *" $vcodec "* ]] || return 0
  acodecs=$(awk -F, '$2 == "audio" {print $1}' <<<"$streams")
  # Only the default (first) audio track is played.
  a=$(head -n1 <<<"$acodecs")
  [[ -z $a || $OK_ACODECS == *" $a "* ]] || return 0
  return 1
}

# subtitle_for <file>: a sidecar with the same name, movie.srt or movie.<lang>.srt
# (lang: 2-8 letters or dashes, e.g. en, pt-BR).
subtitle_for() {
  local f=$1 stem ext cand lang
  stem=${f%.*}
  for ext in srt vtt ass ssa; do
    for cand in "$stem.$ext" "$stem".*."$ext"; do
      lang=${cand#"$stem".}
      lang=${lang%."$ext"}
      [[ $cand == "$stem.$ext" || $lang =~ ^[A-Za-z-]{2,8}$ ]] || continue
      [[ -f $cand ]] && { printf '%s\n' "$cand"; return; }
    done
  done
}

# ---------- serving the queued file ----------
# go2tv opens its -v and -s paths again for every HTTP request, so a path that
# changes after it was queued would serve another file. The runner opens the
# queued file once, checks it is the same file (file_id) and still media, and
# hands go2tv a symlink with the original name, in a private dir, to
# /proc/<runner>/fd/<n>: every open by go2tv or ffmpeg lands on that file.
# The name keeps go2tv's URL, title and extension checks as before. Subtitles
# are copied into the same dir. Sidecar cover art (cover.jpg) is not shown:
# go2tv only reads it from the media file's own directory.
MEDIA_FD="" PLAY_DIR="" PLAY_FILE="" PLAY_SUBS="" PLAY_KIND="" PIN_ERR=""
MAX_SUBS=8388608

unpin() {
  [[ -n $MEDIA_FD ]] && exec {MEDIA_FD}<&-
  [[ -n $PLAY_DIR ]] && rm -rf -- "$PLAY_DIR"
  MEDIA_FD="" PLAY_DIR="" PLAY_FILE="" PLAY_SUBS="" PLAY_KIND=""
}

# pin_media <file> <file-id>: on success sets PLAY_FILE (and PLAY_SUBS for a
# video with a sidecar) and PLAY_KIND; on failure PIN_ERR says why.
pin_media() {
  local file=$1 want=$2 p mime sub real fd
  unpin
  PIN_ERR="it was queued by an older version of tvcast. Add it again."
  [[ $want =~ $FILE_ID_RE ]] || return 1
  PIN_ERR="it is not a local file."
  [[ $file == /* && $file != *://* ]] || return 1
  PIN_ERR="the file is missing."
  open_regular "$file" || return 1
  MEDIA_FD=$OPEN_FD
  p=/proc/$BASHPID/fd/$MEDIA_FD
  PIN_ERR="the file was replaced or changed since it was queued (or its drive was remounted). Add it again."
  [[ $(file_id "$p") == "$want" ]] || { unpin; return 1; }
  mime=$(mime_of "$p")
  PIN_ERR="it is not a video, audio or image file."
  media_ok "$file" "$mime" || { unpin; return 1; }
  PLAY_KIND=$(media_kind "$file" "$mime")
  PIN_ERR="could not prepare it for playback."
  PLAY_DIR=$(mktemp -d "$CACHE_DIR/play.XXXXXX") || { unpin; return 1; }
  PLAY_FILE=$PLAY_DIR/${file##*/}
  ln -s -- "$p" "$PLAY_FILE" || { unpin; return 1; }
  PIN_ERR=""
  [[ $PLAY_KIND == video ]] || return 0
  sub=$(subtitle_for "$file")
  [[ -n $sub ]] || return 0
  # Only a sidecar that really lives next to the video, never one that links elsewhere.
  real=$(readlink -f -- "$sub") || return 0
  [[ ${real%/*} == "${file%/*}" ]] || return 0
  open_regular "$real" || return 0
  fd=$OPEN_FD
  mime=$(mime_of "/proc/$BASHPID/fd/$fd")
  if [[ $mime =~ ^(text/|application/x-subrip$) ]] &&
    (($(stat -L -c %s -- "/proc/$BASHPID/fd/$fd" 2>/dev/null || echo "$MAX_SUBS") < MAX_SUBS)) &&
    head -c "$MAX_SUBS" <&"$fd" >"$PLAY_DIR/${sub##*/}"; then
    PLAY_SUBS=$PLAY_DIR/${sub##*/}
  fi
  exec {fd}<&-
  return 0
}

# ---------- queue ----------
# queue.json: {"items":[{"file","title","kind"}], "index": <0-based current>,
#              "device": {"name","url","control"} | null}
# Written in place under flock so the bar's file watch keeps working.

# q_read prints the queue normalised: items is always an array and index a
# small non-negative integer, so a hand-edited or hostile file can't smuggle
# strings into arithmetic. Unreadable JSON reads as an empty queue.
q_read() {
  local q=""
  [[ -s $QUEUE_FILE ]] && q=$(jq -c '
    (if type == "object" then . else {} end)
    | .items = (if (.items | type) == "array" then .items else [] end)
    | .index = ((.index // 0) | (tonumber? // 0) | floor
                | if . >= 0 and . < 1000000000 then . else 0 end)
    | .device = (if (.device | type) == "object" then .device else null end)' "$QUEUE_FILE" 2>/dev/null)
  if [[ -n $q ]]; then printf '%s\n' "$q"; else echo '{"items":[],"index":0,"device":null}'; fi
}

q_get() { q_read | jq -r "$@"; } # q_get [jq args] <filter>

q_update() { # q_update [jq args...] <filter>
  local new
  (
    flock 9
    new=$(q_read | jq -c "$@") || exit 1
    [[ -n $new ]] && printf '%s\n' "$new" >"$QUEUE_FILE"
  ) 9>"$LOCK_FILE"
}

q_count() { uint "$(q_get '.items | length')"; }
q_index() { uint "$(q_get '.index')"; }

# items_json <file...>: JSON array of queue items. Anything that is not a
# local regular video, audio or image file is skipped (URLs, "-", torrents,
# playlists). Each item records the file's file_id, so the runner can tell
# when the path no longer names the file that was picked.
items_json() {
  local f p mime id title
  for f in "$@"; do
    if [[ $f == - || $f == *://* || ${f,,} == magnet:* ]]; then
      echo "tvcast: skipping $f (not a local file)" >&2
      continue
    fi
    f=$(readlink -f -- "$f") || continue
    if [[ $f == *://* ]] || ! open_regular "$f"; then
      echo "tvcast: skipping $f (not a file)" >&2
      continue
    fi
    p=/proc/$BASHPID/fd/$OPEN_FD
    mime=$(mime_of "$p")
    id=$(file_id "$p")
    exec {OPEN_FD}<&-
    if [[ -z $id ]] || ! media_ok "$f" "$mime"; then
      echo "tvcast: skipping $f (not a video, audio or image file)" >&2
      continue
    fi
    title=${f##*/}
    [[ $title == ?*.* ]] && title=${title%.*}
    jq -cn --arg file "$f" --arg title "$(clean_text 200 <<<"$title")" --arg kind "$(media_kind "$f" "$mime")" \
      --arg id "$id" '{file: $file, title: $title, kind: $kind, id: $id}'
  done | jq -cs .
}

# ensure_device [--pick]: make sure the queue names a TV that still reports
# the ID it was saved with.
ensure_device() {
  local pick=${1:-} url dev name ctl type id
  url=$(q_get '.device.url // empty')
  if [[ -z $pick && -n $url ]] && verify_device "$url" "$(q_get '.device.id // empty')"; then
    return 0
  fi
  dev=$(choose_device "$pick")
  case $? in
    0) ;;
    2) return 2 ;;
    *) die "No TV found on the network. Is it on and on the same network?" ;;
  esac
  IFS=$'\t' read -r name url id <<<"$dev"
  [[ $id =~ $DEV_ID_RE ]] ||
    die "$name does not report a device ID, so tvcast can't tell it apart from another device that later gets its address."
  type=$(url_type "$url")
  if [[ $type == chromecast ]]; then
    # A Chromecast is controlled at its own cast address, there's no description.
    ctl=$url
    cast_ready || notify normal "Cast to TV" "$PYCHROMECAST_HINT Casting without them."
  else
    ctl=$(control_url "$url") || die "$name does not offer DLNA playback control."
  fi
  q_update --arg name "$name" --arg url "$url" --arg control "$ctl" --arg type "$type" --arg id "$id" \
    '.device = {name: $name, url: $url, control: $control, type: $type, id: $id}'
}

start_runner() {
  require_go2tv # every path that plays goes through here or the runner loop
  local env=(--setenv=TERM=xterm-256color --setenv="XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}"
    --setenv="XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}" --setenv="TVCAST_GO2TV=$GO2TV")
  local v
  for v in TVCAST_QUIET TVCAST_TRANSCODE TVCAST_IMAGE_SECONDS TVCAST_POLL_SECONDS TVCAST_START_TIMEOUT \
    TVCAST_CAST_HELPER TVCAST_ALLOW_LOOPBACK; do
    [[ -n ${!v:-} ]] && env+=(--setenv="$v=${!v}")
  done
  owns_unit "$UNIT" && systemctl --user reset-failed "$UNIT" 2>/dev/null
  if [[ $(systemctl --user show "$UNIT" -p LoadState --value 2>/dev/null) == loaded ]] && ! owns_unit "$UNIT"; then
    die "A user unit named $UNIT exists that tvcast did not create; tvcast left it alone."
  fi
  systemd-run --user --quiet --collect --unit "$UNIT" --description "tvcast queue player" \
    "${env[@]}" -p "ExecStopPost=$SELF _cleanup" -- nice -n 5 "$SELF" _run ||
    die "Could not start the cast service."
}

stop_runner() {
  local u
  for u in "$UNIT" "$LEGACY_UNIT"; do
    owns_unit "$u" || continue
    systemctl --user -q is-active "$u" 2>/dev/null && systemctl --user stop "$u" 2>/dev/null
    systemctl --user reset-failed "$u" 2>/dev/null
  done
  return 0
}

# play_at <0-based index> [--pick]: (re)start playback at that queue item.
play_at() {
  local i=$1 count
  count=$(q_count)
  ((count > 0)) || { echo "The queue is empty." >&2; return 1; }
  ((i < 0)) && i=0
  ((i >= count)) && i=$((count - 1))
  stop_runner
  q_update --argjson i "$i" '.index = $i'
  ensure_device "${2:-}" || return 0
  start_runner
}

# ---------- runner (main process of megascan-tvcast.service) ----------

PLAYER_PID=""

kill_player() {
  [[ -n $PLAYER_PID ]] || return 0
  kill -TERM -- "-$PLAYER_PID" 2>/dev/null || kill -TERM "$PLAYER_PID" 2>/dev/null
  wait "$PLAYER_PID" 2>/dev/null
  PLAYER_PID=""
}

nap() { sleep "$1" & wait $!; } # interruptible by the TERM trap

# wait_item_end <kind> <is-last> [blind]: 0 when the item finished, 1 when it
# never started. "Finished" is seen on the device, not from go2tv: STOPPED or
# NO_MEDIA_PRESENT after it was PLAYING, or position reaching duration, on two
# polls in a row. On Chromecast go2tv also exits by itself at the end, which
# counts once playback was seen. "blind" (a Chromecast without pychromecast)
# has no status at all: go2tv exiting after 10 s or more counts as finished.
# Images advance after TVCAST_IMAGE_SECONDS unless last.
wait_item_end() {
  local kind=$1 last=$2 blind=${3:-} saw=0 ends=0 t=0 st pos dur at_end
  local poll=${TVCAST_POLL_SECONDS:-2} start_timeout=${TVCAST_START_TIMEOUT:-90}
  while :; do
    nap "$poll"
    t=$((t + poll))
    if ! kill -0 "$PLAYER_PID" 2>/dev/null; then
      ((saw)) && return 0
      [[ -n $blind ]] && ((t >= 10)) && return 0
      return 1
    fi
    if [[ -n $blind ]]; then
      [[ $kind == image ]] && ((!last && t >= ${TVCAST_IMAGE_SECONDS:-10})) && return 0
      continue
    fi
    st="" pos=0 dur=0
    read -r st pos dur < <(dev_status 2>/dev/null) || true
    at_end=0
    case $st in
      PLAYING | PAUSED_PLAYBACK) saw=1 ;;
      STOPPED | NO_MEDIA_PRESENT) ((saw)) && at_end=1 ;;
    esac
    [[ $st == PLAYING ]] && ((saw && dur > 2 && pos >= dur - 1)) && at_end=1
    if ((at_end)); then ends=$((ends + 1)); else ends=0; fi
    ((ends >= 2)) && return 0
    if [[ $kind == image ]] && ((!last && t >= ${TVCAST_IMAGE_SECONDS:-10})); then
      return 0
    fi
    ((!saw && t >= start_timeout)) && return 1
  done
}

cmd_run() {
  trap 'kill_player; unpin' EXIT
  trap 'exit 0' TERM INT
  local q count idx item file fid title kind subs tc args name url ctl devid last type blind=""
  export TVCAST_IN_RUNNER=1
  rm -rf -- "$CACHE_DIR"/play.*
  while :; do
    q=$(q_read)
    count=$(uint "$(jq '.items | length' <<<"$q")")
    idx=$(uint "$(jq '.index' <<<"$q")")
    if ((idx >= count)); then
      ((count > 0)) && notify low "Cast to TV" "Queue finished."
      q_update '.items = [] | .index = 0'
      exit 0
    fi
    item=$(jq -c --argjson i "$idx" '.items[$i]' <<<"$q")
    file=$(jq -r '.file // empty' <<<"$item")
    fid=$(jq -r '.id // empty' <<<"$item")
    title=$(jq -r .title <<<"$item")
    name=$(jq -r '.device.name // "TV"' <<<"$q")
    url=$(jq -r '.device.url // empty' <<<"$q")
    ctl=$(jq -r '.device.control // empty' <<<"$q")
    devid=$(jq -r '.device.id // empty' <<<"$q")
    [[ -n $url && -n $ctl ]] || die "No TV selected."
    # The queue file is re-read on every item; never hand go2tv a URL that
    # wouldn't pass discovery.
    lan_url "$url" || die "Refusing a TV address that is not on the local network: $url"
    type=$(url_type "$url")
    if [[ $type == chromecast && -z $blind ]] && ! cast_ready; then
      blind=1
      notify normal "Cast to TV" "$PYCHROMECAST_HINT Casting without them."
    fi
    [[ $type == chromecast ]] || blind=""
    rm -f "$CC_STATUS_FILE"

    if ! pin_media "$file" "$fid"; then
      notify normal "Cast to TV" "Skipping $title: $PIN_ERR"
      q_update --argjson i "$idx" '.index = $i + 1'
      continue
    fi
    kind=$PLAY_KIND

    # Checked before every item: the address may now belong to another device.
    # The state is reset first so the stop hook doesn't send Stop to it.
    if ! verify_device "$url" "$devid" 3; then
      write_state '{"active":false}'
      case $DEV_ERR in
        down) die "$name did not answer at $(url_host "$url"). Turn it on, then press Play." ;;
        changed) die "The device at $(url_host "$url") is no longer $name. Pick the TV again in the TV Cast panel." ;;
        *) die "tvcast now checks which TV it casts to. Pick the TV again in the TV Cast panel." ;;
      esac
    fi

    # Checked before every launch, not only at the CLI entry points: a resumed
    # queue goes straight to the runner, and go2tv may be replaced mid-queue.
    require_go2tv
    args=(-v "$PLAY_FILE" -t "$url")
    subs="" tc=0
    if [[ $kind == video ]]; then
      [[ -n $PLAY_SUBS ]] && { args+=(-s "$PLAY_SUBS"); subs=${file%/*}/${PLAY_SUBS##*/}; }
      # go2tv picks Chromecast transcoding itself; the codec lists here are
      # for DLNA TVs, so on a Chromecast only TVCAST_TRANSCODE=always forces it.
      if [[ $type == chromecast ]]; then
        [[ ${TVCAST_TRANSCODE:-} == always ]] && { args+=(-tc); tc=1; }
      elif needs_transcode "$PLAY_FILE"; then
        args+=(-tc)
        tc=1
      fi
    fi
    last=$((idx + 1 >= count ? 1 : 0))

    write_state "$(jq -cn --arg title "$title" --arg file "$file" --arg kind "$kind" \
      --arg device "$url" --arg name "$name" --arg control "$ctl" --arg subs "$subs" --arg type "$type" \
      --argjson transcode "$tc" --argjson started "$(date +%s)" --argjson index "$idx" --argjson count "$count" \
      '{active: true, title: $title, file: $file, kind: $kind, device: $device, deviceName: $name,
        type: $type, control: $control, subtitles: $subs, transcode: ($transcode == 1), started: $started,
        index: $index, count: $count}')"
    if ((count > 1)); then
      notify low "Casting $((idx + 1))/$count to $name" "$title"
    else
      notify low "Casting to $name" "$title"
    fi

    SHELL=/bin/bash setsid script -qfec "$(printf '%q ' "$GO2TV" "${args[@]}")" "$LOG_FILE" </dev/null >/dev/null 2>&1 &
    PLAYER_PID=$!

    if ! wait_item_end "$kind" "$last" "$blind"; then
      notify normal "Cast to TV" "Couldn't play $title, skipping. See $LOG_FILE"
    fi
    kill_player
    unpin
    # Advance only past the item we played; a concurrent edit may have moved it.
    q_update --argjson i "$idx" --arg file "$file" \
      'if (.items[$i].file // "") == $file then .index = $i + 1
       else .index = ([.items | to_entries[] | select(.value.file == $file) | .key][0] // $i) + 1 end'
  done
}

# ---------- commands ----------

pick_files() { # prints one path per line; exits quietly when nothing is picked
  local picked status=0
  picked=$(omarchy-file-select --title "${1:-Cast to TV}" --multiple \
    --extensions "$VIDEO_EXT $AUDIO_EXT $IMAGE_EXT") || status=$?
  ((status > 1)) && die "The file chooser could not open."
  [[ -n $picked ]] || exit 0
  # One absolute path per line. A line that doesn't start with / continues a
  # file name containing a newline: that whole name is dropped, or its pieces
  # would name other files.
  grep -qv '^/' <<<"$picked" && notify normal "Cast to TV" "Skipped a file whose name contains a line break."
  awk 'BEGIN { ok = 0 } /^\// { if (ok) print prev; prev = $0; ok = 1; next } { ok = 0 } END { if (ok) print prev }' <<<"$picked"
}

parse_pick() { # sets PICK and FILES from "[--pick] [file...]"
  PICK=""
  FILES=()
  [[ ${1:-} == --pick ]] && { PICK=--pick; shift; }
  FILES=("$@")
}

checked_items() { # JSON items for FILES; tells the user what was skipped
  local items n skipped
  items=$(items_json "${FILES[@]}")
  n=$(uint "$(jq length <<<"$items")")
  skipped=$((${#FILES[@]} - n))
  ((n > 0)) || die "Nothing playable was picked. tvcast casts local video, audio and image files only."
  ((skipped > 0)) && notify normal "Cast to TV" "Skipped $skipped that $( ((skipped == 1)) && echo "is not a local video, audio or image file" || echo "are not local video, audio or image files")."
  printf '%s\n' "$items"
}

cmd_cast() { # replace the queue with these files and play from the first
  local items
  parse_pick "$@"
  require_go2tv
  ((${#FILES[@]})) || readarray -t FILES < <(pick_files "Cast to TV")
  ((${#FILES[@]})) || exit 0
  items=$(checked_items) || exit 1
  stop_runner
  q_update --argjson items "$items" '.items = $items | .index = 0'
  ensure_device "$PICK" || exit 0
  start_runner
}

cmd_add() { # append; starts playing only when nothing is queued or playing
  local items before
  parse_pick "$@"
  ((${#FILES[@]})) || readarray -t FILES < <(pick_files "Add to TV queue")
  ((${#FILES[@]})) || exit 0
  items=$(checked_items) || exit 1
  before=$(q_count)
  if ((before == 0)); then
    q_update --argjson items "$items" '.items = $items | .index = 0'
  else
    q_update --argjson items "$items" '.items += $items'
  fi
  if ! is_active && ((before == 0)); then
    require_go2tv
    ensure_device "$PICK" || exit 0
    start_runner
  else
    notify low "Cast to TV" "Added $(jq length <<<"$items") to the queue ($(q_count) total)."
  fi
}

cmd_pick_device() { # search the network and remember the chosen TV
  ensure_device --pick || return 0
  notify low "Cast to TV" "Casting to $(q_get '.device.name // "TV"') from now on."
}

cmd_next() {
  local i count
  i=$(q_index) count=$(q_count)
  ((i + 1 < count)) || { notify low "Cast to TV" "That was the last item in the queue."; return 0; }
  play_at $((i + 1))
}

cmd_prev() { play_at $(($(q_index) - 1)); }

cmd_play_index() { # 1-based
  if ! [[ ${1:-} =~ ^[1-9][0-9]*$ ]]; then echo "usage: tvcast play-index <N>" >&2; return 2; fi
  play_at $(($1 - 1))
}

cmd_remove() { # 1-based
  if ! [[ ${1:-} =~ ^[1-9][0-9]*$ ]]; then echo "usage: tvcast remove <N>" >&2; return 2; fi
  local n=$(($1 - 1)) i count was_active=0
  count=$(q_count) i=$(q_index)
  ((n < count)) || { echo "tvcast: no item $1" >&2; return 1; }
  is_active && was_active=1
  if ((n == i && was_active)); then
    stop_runner
  fi
  q_update --argjson n "$n" '.items |= (to_entries | map(select(.key != $n)) | map(.value))
    | if $n < .index then .index -= 1 else . end'
  count=$(q_count)
  if ((count == 0)); then
    cmd_clear
  elif ((n == i && was_active)); then
    # The next item slid into the current slot; past the end means we're done.
    if ((i < count)); then start_runner; else q_update '.index = (.items | length) - 1'; fi
  elif ((i >= count)); then
    q_update '.index = (.items | length) - 1'
  fi
}

cmd_move() { # move <N> up|down (1-based)
  [[ ${1:-} =~ ^[0-9]+$ && ${2:-} =~ ^(up|down)$ ]] || { echo "usage: tvcast move <N> up|down" >&2; return 2; }
  local a=$((10#$1 - 1)) b count
  count=$(q_count)
  if [[ $2 == up ]]; then b=$((a - 1)); else b=$((a + 1)); fi
  ((a >= 0 && a < count && b >= 0 && b < count)) || return 0
  q_update --argjson a "$a" --argjson b "$b" \
    '.items[$a] as $x | .items[$a] = .items[$b] | .items[$b] = $x
     | if .index == $a then .index = $b elif .index == $b then .index = $a else . end'
  # Keep the now-playing count/index in step for the bar.
  is_active && [[ -s $STATE_FILE ]] && write_state "$(jq -c --argjson i "$(q_index)" '.index = $i' "$STATE_FILE")"
  return 0
}

cmd_clear() {
  stop_runner
  q_update '.items = [] | .index = 0'
  write_state '{"active":false}'
}

cmd_cleanup() { # ExecStopPost: tell the TV to stop, mark idle
  [[ $(state_get active) == true ]] && dev_control stop >/dev/null 2>&1
  write_state '{"active":false}'
  rm -f "$CC_STATUS_FILE"
}

cmd_stop() { # stop playback, keep the queue (play resumes at the same item)
  # Stop the service first so its poller can't mistake the TV's STOPPED for
  # the end of the file and advance; its ExecStopPost sends the TV Stop.
  stop_runner
  [[ $(state_get active) == true ]] && { dev_control stop >/dev/null 2>&1; write_state '{"active":false}'; }
  return 0
}

cmd_pause() { dev_control pause; }
cmd_resume() { dev_control play; }

cmd_play() { # resume, or start the queue when idle
  if is_active; then cmd_resume; else play_at "$(q_index)"; fi
}

cmd_toggle() {
  is_active || { cmd_play; return; }
  case $(transport_state) in
    PLAYING | TRANSITIONING) cmd_pause ;;
    *) cmd_resume ;;
  esac
}

cmd_seek() {
  local arg=${1:?usage: tvcast seek <+N|-N|hh:mm:ss>} pos dur target
  if [[ $arg =~ ^[+-][0-9]+$ ]]; then
    read -r pos dur < <(position_info) || return 1
    target=$((pos + arg))
    ((target < 0)) && target=0
    ((dur > 0 && target > dur - 1)) && target=$((dur - 1))
    arg=$(s_to_hms "$target")
  elif [[ $arg =~ ^[0-9]+$ ]]; then
    arg=$(s_to_hms "$arg")
  elif ! [[ $arg =~ ^[0-9]{1,6}:[0-9]{1,2}:[0-9]{1,2}$ ]]; then
    echo "usage: tvcast seek <+N|-N|secs|hh:mm:ss>" >&2
    return 2
  fi
  dev_control seek "$(hms_to_s "$arg")" || { [[ -n $SEEK_ERR ]] && die "$SEEK_ERR"; return 1; }
}

# seek-to: absolute seek in seconds, clamped to the track (the panel's slider).
cmd_seek_to() {
  local target=${1:-} pos dur
  [[ $target =~ ^[0-9]+$ ]] || die "usage: tvcast seek-to <seconds>"
  is_active || die "Nothing is casting."
  read -r pos dur < <(position_info) || die "The TV did not report a position."
  ((dur > 0)) || die "The TV reports no duration for this item, so it can't seek."
  ((target > dur - 1)) && target=$((dur - 1))
  dev_control seek "$target" || die "${SEEK_ERR:-The TV refused the seek.}"
}

# list: queue plus now-playing, no network calls. status --json adds the TV's
# transport state and position while casting.
cmd_list() {
  local active=false st last=""
  [[ -s $DEVICE_FILE ]] && last=$(cut -f1 "$DEVICE_FILE")
  if is_active; then active=true; elif [[ $(state_get active) == true ]]; then write_state '{"active":false}'; fi
  st='{}'
  [[ $active == true && -s $STATE_FILE ]] && st=$(cat "$STATE_FILE")
  q_read | jq -c --argjson active "$active" --argjson st "$st" --arg last "$last" '{
    active: $active,
    index: (.index // 0),
    count: (.items | length),
    deviceName: (.device.name // $last),
    deviceType: ($st.type // .device.type // ""),
    title: ($st.title // (.items[.index // 0].title // "")),
    kind: ($st.kind // ""),
    transcode: ($st.transcode // false),
    items: [.items | to_entries[] | {n: (.key + 1), title: .value.title, kind: .value.kind, file: .value.file}]
  }'
}

cmd_status() {
  local json=${1:-} st="" pos=0 dur=0 list vol=-1 muted=0
  list=$(cmd_list)
  if [[ $(jq -r .active <<<"$list") == true ]]; then
    if [[ $(active_type) == chromecast ]]; then
      read -r st pos dur < <(cc_status 2>/dev/null) || true
    else
      st=$(transport_state 2>/dev/null)
      read -r pos dur < <(position_info 2>/dev/null) || true
    fi
    [[ $json == --json ]] && { read -r vol muted < <(dev_volume 2>/dev/null) || vol=-1; }
  fi
  if [[ $json == --json ]]; then
    vol=$( [[ $vol =~ ^[0-9]{1,3}$ ]] && uint "$vol" || echo -1)
    jq -c --arg st "$st" --argjson pos "${pos:-0}" --argjson dur "${dur:-0}" \
      --argjson vol "$vol" --argjson muted "$( [[ ${muted:-0} == 1 ]] && echo true || echo false)" \
      '. + {transport: $st, position: $pos, duration: $dur,
            volumeControl: ($vol >= 0), volume: (if $vol >= 0 then $vol else null end), muted: $muted}' <<<"$list"
  elif [[ $(jq -r .active <<<"$list") == true ]]; then
    jq -r --arg st "${st:-UNKNOWN}" --arg p "$(s_to_hms "${pos:-0}")" --arg d "$(s_to_hms "${dur:-0}")" \
      '"\(.title) (\(.index + 1)/\(.count)) on \(.deviceName): \($st) \($p) / \($d)"' <<<"$list"
  elif (($(uint "$(jq -r .count <<<"$list")") > 0)); then
    jq -r '"Stopped. \(.count) in the queue, next: \(.title)"' <<<"$list"
  else
    echo "Nothing is casting."
  fi
}

VOLUME_STEP=5
cmd_volume() {
  local arg=${1:-} vol muted target dir=0
  is_active || die "Nothing is casting."
  read -r vol muted < <(dev_volume) || die "This TV doesn't offer volume control."
  case $arg in
    "") if ((muted)); then echo "$vol (muted)"; else echo "$vol"; fi; return 0 ;;
    up) target=$((vol + VOLUME_STEP)) dir=1 ;;
    down) target=$((vol - VOLUME_STEP)) dir=-1 ;;
    +[0-9] | +[0-9][0-9] | +[0-9][0-9][0-9]) target=$((vol + 10#${arg#+})) dir=1 ;;
    -[0-9] | -[0-9][0-9] | -[0-9][0-9][0-9]) target=$((vol - 10#${arg#-})) dir=-1 ;;
    [0-9] | [0-9][0-9] | [0-9][0-9][0-9]) target=$((10#$arg)) ;;
    *) echo "usage: tvcast volume [N|+N|-N|up|down]" >&2; return 2 ;;
  esac
  ((target < 0)) && target=0
  ((target > 100)) && target=100
  dev_set_volume "$target" "$vol" "$dir" || die "The TV refused the volume change."
}

cmd_mute() {
  local arg=${1:-toggle} muted on
  is_active || die "Nothing is casting."
  case $arg in
    on) on=1 ;;
    off) on=0 ;;
    toggle)
      read -r _ muted < <(dev_volume) || die "This TV doesn't offer volume control."
      on=$((muted ? 0 : 1)) ;;
    *) echo "usage: tvcast mute [on|off|toggle]" >&2; return 2 ;;
  esac
  dev_set_mute "$on" || die "This TV doesn't offer volume control."
}

cmd_notify_status() { notify low "Cast to TV" "$(cmd_status)"; }

case ${1:-cast} in
  cast) shift; cmd_cast "$@" ;;
  add) shift; cmd_add "$@" ;;
  devices) shift; cmd_devices "$@" ;;
  pick-device) cmd_pick_device ;;
  next) cmd_next ;;
  prev | previous) cmd_prev ;;
  play-index) shift; cmd_play_index "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  move) shift; cmd_move "$@" ;;
  clear) cmd_clear ;;
  list) cmd_list ;;
  toggle) cmd_toggle ;;
  pause) cmd_pause ;;
  play) cmd_play ;;
  resume) cmd_resume ;;
  seek) shift; cmd_seek "$@" ;;
  seek-to) shift; cmd_seek_to "$@" ;;
  volume) shift; cmd_volume "$@" ;;
  mute) shift; cmd_mute "$@" ;;
  stop) cmd_stop ;;
  status) shift; cmd_status "$@" ;;
  notify-status) cmd_notify_status ;;
  active) is_active ;;
  has-queue) (($(q_count) >= $(uint "${2:-1}"))) ;;
  _run) cmd_run ;;
  _cleanup) cmd_cleanup ;;
  _stop-owned) stop_runner ;;
  -h | --help | help) sed -n '3,31p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) echo "tvcast: unknown command '$1' (try tvcast help)" >&2; exit 2 ;;
esac
