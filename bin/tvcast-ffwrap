#!/bin/bash
# ffmpeg/ffprobe as go2tv sees them (tvcast puts links named ffmpeg and ffprobe
# to this file first on go2tv's PATH). Every input that is a local path may
# only be opened by a real media demuxer: a queued file rewritten into a DASH
# manifest or an HLS playlist would otherwise make ffmpeg read and serve other
# local files it names.
FORMATS=mov,matroska,mpegts,avi,mpeg,asf,flv,ogg,mp3,flac,wav,aac,aiff,w64,caf,ac3,eac3,dts,truehd,mpegvideo,m4v,h264,hevc,dv,ivf,obu,amr,amrnb,amrwb,au,voc,jpeg_pipe,png_pipe,gif,webp_pipe,bmp_pipe
case ${0##*/} in
  ffmpeg) real=${TVCAST_FFMPEG:-} ;;
  ffprobe) real=${TVCAST_FFPROBE:-} ;;
  *) echo "tvcast-ffwrap: run as ffmpeg or ffprobe" >&2; exit 2 ;;
esac
[[ $real == /* && -x $real && $(readlink -f -- "$real") != "$(readlink -f -- "$0")" ]] || {
  echo "tvcast-ffwrap: the real ${0##*/} is not known" >&2
  exit 127
}
out=()
if [[ ${0##*/} == ffprobe ]]; then
  out=(-format_whitelist "$FORMATS")
fi
prev=""
for a in "$@"; do
  if [[ ${0##*/} == ffmpeg && $prev == -i && $a == /* ]]; then
    unset 'out[${#out[@]}-1]'
    out+=(-format_whitelist "$FORMATS" -i)
  fi
  out+=("$a")
  prev=$a
done
exec "$real" "${out[@]}"
