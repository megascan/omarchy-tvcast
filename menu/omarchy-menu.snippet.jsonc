  // tvcast: Trigger > Cast to TV. Also `omarchy menu summon cast`.
  "trigger.cast": {"icon":"󰄘","label":"Cast to TV","aliases":["cast","tv"],"description":"Play local video, audio or image files on the TV"},
  "trigger.cast.file": {"icon":"󰄘","label":"Cast files to TV…","description":"Pick one or more files; replaces the queue","action":"$HOME/.local/bin/tvcast cast"},
  "trigger.cast.add": {"icon":"󰐕","label":"Add to queue…","when":"$HOME/.local/bin/tvcast has-queue","action":"$HOME/.local/bin/tvcast add"},
  "trigger.cast.other": {"icon":"󰔂","label":"Cast files to another TV…","description":"Search the network for TVs first","action":"$HOME/.local/bin/tvcast cast --pick"},
  "trigger.cast.play": {"icon":"󰐊","label":"Play queue","when":"! systemctl --user -q is-active tvcast.service && $HOME/.local/bin/tvcast has-queue","action":"$HOME/.local/bin/tvcast play"},
  "trigger.cast.toggle": {"icon":"󰐎","label":"Pause/Resume","when":"systemctl --user -q is-active tvcast.service","action":"$HOME/.local/bin/tvcast toggle"},
  "trigger.cast.next": {"icon":"󰒭","label":"Next","when":"$HOME/.local/bin/tvcast has-queue 2","action":"$HOME/.local/bin/tvcast next"},
  "trigger.cast.prev": {"icon":"󰒮","label":"Previous","when":"$HOME/.local/bin/tvcast has-queue 2","action":"$HOME/.local/bin/tvcast prev"},
  "trigger.cast.back": {"icon":"󰶖","label":"Back 30 seconds","when":"systemctl --user -q is-active tvcast.service","action":"$HOME/.local/bin/tvcast seek -30"},
  "trigger.cast.forward": {"icon":"󰴆","label":"Forward 30 seconds","when":"systemctl --user -q is-active tvcast.service","action":"$HOME/.local/bin/tvcast seek +30"},
  "trigger.cast.status": {"icon":"󰋽","label":"What's playing","when":"$HOME/.local/bin/tvcast has-queue","action":"$HOME/.local/bin/tvcast notify-status"},
  "trigger.cast.stop": {"icon":"󰓛","label":"Stop casting","when":"systemctl --user -q is-active tvcast.service","action":"$HOME/.local/bin/tvcast stop"},
  "trigger.cast.clear": {"icon":"󰩺","label":"Clear queue","when":"$HOME/.local/bin/tvcast has-queue","action":"$HOME/.local/bin/tvcast clear"},
