  // tvcast: Trigger > Cast to TV. Also `omarchy menu summon cast`.
  "trigger.cast": {"icon":"󰄘","label":"Cast to TV","aliases":["cast","tv"],"description":"Play local video, audio or image files on the TV"},
  "trigger.cast.file": {"icon":"󰄘","label":"Cast files to TV…","description":"Pick one or more files; replaces the queue","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" has-queue 0","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" cast"},
  "trigger.cast.add": {"icon":"󰐕","label":"Add to queue…","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" has-queue","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" add"},
  "trigger.cast.other": {"icon":"󰔂","label":"Cast files to another TV…","description":"Search the network for TVs first","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" has-queue 0","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" cast --pick"},
  "trigger.cast.play": {"icon":"󰐊","label":"Play queue","when":"! \"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" active && \"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" has-queue","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" play"},
  "trigger.cast.toggle": {"icon":"󰐎","label":"Pause/Resume","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" active","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" toggle"},
  "trigger.cast.next": {"icon":"󰒭","label":"Next","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" has-queue 2","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" next"},
  "trigger.cast.prev": {"icon":"󰒮","label":"Previous","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" has-queue 2","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" prev"},
  "trigger.cast.back": {"icon":"󰶖","label":"Back 30 seconds","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" active","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" seek -30"},
  "trigger.cast.forward": {"icon":"󰴆","label":"Forward 30 seconds","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" active","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" seek +30"},
  "trigger.cast.volup": {"icon":"󰝝","label":"Volume up","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" active","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" volume up"},
  "trigger.cast.voldown": {"icon":"󰝞","label":"Volume down","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" active","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" volume down"},
  "trigger.cast.mute": {"icon":"󰝟","label":"Mute/Unmute","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" active","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" mute"},
  "trigger.cast.status": {"icon":"󰋽","label":"What's playing","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" has-queue","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" notify-status"},
  "trigger.cast.stop": {"icon":"󰓛","label":"Stop casting","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" active","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" stop"},
  "trigger.cast.clear": {"icon":"󰩺","label":"Clear queue","when":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" has-queue","action":"\"$HOME/.config/omarchy/plugins/megascan.tvcast/bin/tvcast\" clear"},
